   "panels": []
  },
  {
   "type": "stat",
   "title": "Edge availability, last hour",
   "id": 2,
   "description": "Share of requests at the public edge without a 5xx. Target 99.95%.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "1 - sum(increase(haproxy_frontend_http_responses_total{job=\"edge\",proxy=\"public\",code=\"5xx\"}[1h])) / clamp_min(sum(increase(haproxy_frontend_http_responses_total{job=\"edge\",proxy=\"public\"}[1h])), 1)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "wideLayout": true
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 3,
     "noValue": "no traffic yet",
     "mappings": [],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#dc3545",
        "value": null
       },
       {
        "color": "#0f996d",
        "value": 0.9995
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Error budget left, last hour",
