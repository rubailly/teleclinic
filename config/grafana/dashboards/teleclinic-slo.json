   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "1 - (sum(increase(haproxy_frontend_http_responses_total{job=\"edge\",proxy=\"public\",code=\"5xx\"}[1h])) / clamp_min(sum(increase(haproxy_frontend_http_responses_total{job=\"edge\",proxy=\"public\"}[1h])), 1)) / 0.0005",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
