...@style
direction: right

major: "Majority side: nodes 1 and 2 (2 of 3) keep working" {
  class: zone
  style: {stroke: "#1E8449"; fill: "#F3FAF5"; font-color: "#1E8449"}
  grid-columns: 1
  vertical-gap: 30
  nodes: "" {
    style: {opacity: 0}
    grid-columns: 2
    horizontal-gap: 30
    n1: "Node 1\netcd + Patroni + Kafka" {class: good}
    n2: "Node 2\netcd + Patroni + Kafka" {class: good}
  }
  what: "etcd quorum 2 of 3 holds the leader key, or elects a new one\nthe synchronous replica is promoted if the leader was on the other side\nKafka controller quorum intact, ISR still 2\nwrites accepted; HAProxy follows the new primary" {
    style: {fill: "#FFFFFF"; stroke: "#1E8449"; stroke-width: 2; border-radius: 8; font-size: 15}
  }
}

minor: "Minority side: node 3 (1 of 3) stops accepting writes" {
  class: zone
  style: {stroke: "#C0392B"; fill: "#FEF5F4"; font-color: "#C0392B"}
  grid-columns: 1
  vertical-gap: 30
  n3: "Node 3\netcd + Patroni + Kafka" {class: edge}
  what: "cannot renew the leader key, so Patroni demotes PostgreSQL\n(the watchdog fences a hung process)\nKafka: no controller quorum, ISR below 2: producers get\nNotEnoughReplicas, so no divergent write\non heal: pg_rewind, then it rejoins as a replica" {
    style: {fill: "#FFFFFF"; stroke: "#C0392B"; stroke-width: 2; border-radius: 8; font-size: 15}
  }
}

major <-> minor: "NETWORK PARTITION" {
  style: {stroke: "#C0392B"; stroke-width: 4; stroke-dash: 6; font-color: "#C0392B"; bold: true; font-size: 16}
}
