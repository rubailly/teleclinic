digraph G {
  graph [fontname="DejaVu Sans", fontsize=13, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=1.1];
  node  [fontname="DejaVu Sans", fontsize=13, shape=box, style="rounded,filled", penwidth=2, margin="0.25,0.12"];
  edge  [fontname="DejaVu Sans", fontsize=11, color="#4A5568", arrowsize=0.8, penwidth=1.3];
  {rank=same; pat [label="Patient\nWeb / Mobile / USSD", color="#2D3748", fillcolor="white"];
              cli [label="Clinician / Nurse", color="#2D3748", fillcolor="white"];
              reg [label="Regulator / Auditor", color="#2D3748", fillcolor="white"]}
  tc [label="TeleClinic\nnational telemedicine platform\n(on-premise, Rwanda)", fontsize=16, penwidth=3, color="#0B5CC0", fillcolor="#E8F1FB", margin="0.4,0.2"];
  {rank=same;
   ia [label="IremboAccount\nidentity (OIDC)", color="#C77700", fillcolor="#FFF4E0"];
   ip [label="IremboPay\npayments, reimbursements", color="#C77700", fillcolor="#FFF4E0"];
   ebz [label="eBuzima\nhealth centres: one central\ninstance, a tenant per centre", color="#666666", fillcolor="#F1F1F1"];
   omrs [label="Hospital EMRs\nOpenMRS, one per\ndistrict / referral hospital", color="#666666", fillcolor="#F1F1F1"];
   nat [label="National systems\nregistry, shared record,\nDHIS2", color="#666666", fillcolor="#F1F1F1"];
   tel [label="Telecom aggregators\nUSSD / SMS / voice", color="#666666", fillcolor="#F1F1F1"]}
  pat -> tc [label="book, triage,\nconsult, pay"];
  cli -> tc [label="review queue,\nconsultation"];
  reg -> tc [label="audit reports"];
  tc -> ia [label="OIDC login"];
  tc -> ip [label="payment intents"];
  ip -> tc [label="signed webhooks", style=dashed];
  tc -> ebz [dir=both, label="sync: Frappe REST\n+ webhooks"];
  tc -> omrs [dir=both, label="sync: FHIR"];
  tc -> nat [label="FHIR / reports"];
  tc -> tel [dir=both, label="USSD"];
}
