# TeleClinic demo environment. Copy to .env (make does this for you).
# Every value here is a DEMO value for a local, synthetic-data stack. Never reuse them anywhere real.

# Public base URL of the edge (HAProxy). The browser and the OIDC redirect use it.
PUBLIC_BASE_URL=http://localhost:9080

# Keycloak, the labelled stand-in for IremboAccount
KEYCLOAK_PUBLIC_URL=http://localhost:9180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=demo-admin-change-me
OIDC_REALM=irembo-mock
OIDC_CLIENT_ID=teleclinic-core
OIDC_CLIENT_SECRET=demo-core-secret-change-me

# One password for all synthetic demo users: patient1, patient2, clinician1, clerk1, admin1
DEMO_USER_PASSWORD=demo-pass-123

# The edge runs plain HTTP on localhost for the demo, so the session cookie cannot be Secure here.
# In any real deployment TLS terminates at HAProxy and this is true.
SESSION_COOKIE_SECURE=false

# Data tier (demo values)
DB_USER=teleclinic
DB_PASSWORD=demo-db-change-me
PG_SUPERUSER_PASSWORD=demo-pg-super-change-me
PG_REPLICATION_PASSWORD=demo-pg-repl-change-me

# IremboPay (labelled mock). The browser reaches the hosted checkout on the public URL.
IREMBOPAY_PUBLIC_URL=http://localhost:9280
IREMBOPAY_WEBHOOK_SECRET=demo-webhook-secret-change-me

# Payment window before an unpaid consultation expires (shorten for the expiry demo, for example 1m)
PAYMENT_WINDOW=10m

# AI trust zone (demo values). The vault key lets only the core turn pseudonym tokens back into cases.
VAULT_KEY=demo-vault-key-change-me
AI_CALLBACK_SECRET=demo-ai-callback-secret-change-me
# Multiplies review deadlines (EMERGENCY 15 min, URGENT 60 min, ...). 0.01 makes timeouts visible in a demo.
TRIAGE_SLA_SCALE=1.0

# Shared key between the core and the USSD gateway (internal channel calls and SMS)
USSD_GATEWAY_KEY=demo-ussd-gateway-key-change-me

# Grafana admin login (dashboards are readable without it)
GRAFANA_ADMIN_PASSWORD=demo-grafana-change-me

# EMR and sync gateway: `make emr-up` generates these into .env (scripts/emr/env.py)
OPENMRS_DB_PASSWORD=<generated>
OPENMRS_DB_ROOT_PASSWORD=<generated>
OPENMRS_ADMIN_PASSWORD=Admin123
OPENMRS_SYNC_PASSWORD=<generated>
OPENFN_DB_PASSWORD=<generated>
OPENFN_SECRET_KEY_BASE=<generated>
OPENFN_ENCRYPTION_KEY=<generated>
OPENFN_WORKER_SECRET=<generated>
OPENFN_WORKER_RUNS_PRIVATE_KEY=<generated>
OPENFN_ADMIN_PASSWORD=<generated>
SYNC_KEY=<generated>
